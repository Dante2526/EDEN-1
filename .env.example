# ==============================================================================
# Synap — Variáveis de Ambiente (.env)
# ==============================================================================
# Copie este arquivo para .env.local (ou .env):
#   cp .env.example .env.local
#
# EM PRODUÇÃO (Cloudflare Pages): NÃO use este arquivo. Configure tudo no
# dashboard do CF Pages em Settings → Environment variables. Ver seção
# "Deploy no Cloudflare Pages" no README.
# ==============================================================================

# 1. NVIDIA API Key (Obrigatória para o Chat e Modelos GLM-5.3)
# Obtenha sua chave gratuita com créditos em: https://build.nvidia.com
NVIDIA_API_KEY="nvapi-your-key-here"

# 2. Google Gemini API Key (Opcional - para Voz Neural de Estúdio TTS em português pt-BR)
# Obtenha gratuitamente em segundos no Google AI Studio: https://aistudio.google.com/app/apikey
# Sem essa chave, o sistema utiliza automaticamente a síntese local do navegador (Web Speech API).
GEMINI_API_KEY="AIzaSy-your-gemini-key-here"

# 3. GitHub Token / Personal Access Token (Recomendado)
# Permite ao Synap inspecionar repositórios, navegar no Explorer e criar commits no Source Control.
# Escopos recomendados: "Contents: Read and Write" + "Metadata: Read".
# Gere em: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN="ghp_your_github_token_here"
# Alias alternativo (mesma coisa que GITHUB_TOKEN, lido como fallback):
# GITHUB_PAT="ghp_your_github_token_here"

# 4. Segurança da API (Obrigatório em Produção)
# Configure a mesma senha nos dois (Frontend manda via header x-api-key, Backend valida).
# No CF Pages: VITE_API_SECRET vai como "Build environment variable" (não runtime),
#              SYNAP_API_SECRET vai como runtime binding.
VITE_API_SECRET="sua-senha-super-secreta"
SYNAP_API_SECRET="sua-senha-super-secreta"

# 5. Cloudflare Workers AI (Opcional — necessário apenas para modelos @cf/*)
# Habilita o uso de modelos como @cf/deepseek-ai/deepseek-r1-distill-qwen-32b.
# O Account ID fica no painel direito do dashboard da Cloudflare.
# O API Token deve ter permissão "Workers AI > Read" (e "Workers AI > Beta" se aplicável).
# Crie em: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID="your-account-id-here"
CLOUDFLARE_API_TOKEN="cf-your-api-token-here"

# 6. Rate Limit Global (Opcional — Upstash Redis ou Vercel KV)
# Se configurado, rate limit é compartilhado entre todas as instâncias do Worker
# (global). Se não configurado, cai pra rate limit em memória (isolado por edge
# isolate — menos preciso mas funcional).
# Crie gratuitamente em: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Alias alternativo (mesma coisa, lido como fallback):
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# 7. PORT (apenas dev local via server.ts — não usado no CF Pages)
# PORT=3000
# NODE_ENV=development
