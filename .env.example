# ==============================================================================
# Synap — Variáveis de Ambiente (.env)
# ==============================================================================
# Copie este arquivo para .env.local (ou .env):
#   cp .env.example .env.local
# ==============================================================================

# 1. NVIDIA API Key (Obrigatória para o Chat e Modelos GLM-5.3)
# Obtenha sua chave gratuita com créditos em: https://build.nvidia.com
NVIDIA_API_KEY="nvapi-your-key-here"

# 2. Google Gemini API Key (Opcional - para Voz Neural de Estúdio TTS em português pt-BR)
# Obtenha gratuitamente em segundos no Google AI Studio: https://aistudio.google.com/app/apikey
# Sem essa chave, o sistema utiliza automaticamente a síntese local do navegador (Web Speech API).
GEMINI_API_KEY="AIzaSy-your-gemini-key-here"

# 3. APP_URL: URL onde a aplicação está hospedada.
# Injetado automaticamente pelo Google Cloud / AI Studio em ambiente de produção.
APP_URL="MY_APP_URL"

# 4. GitHub Token / Personal Access Token (Recomendado na Vercel / Servidor)
# Permite ao Synap inspecionar repositórios, navegar no Explorer e criar commits no Source Control com segurança.
# Escopos recomendados: "Contents: Read and Write" + "Metadata: Read".
# Gere em: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN="ghp_your_github_token_here"

# 5. Segurança da API (Obrigatório em Produção na Vercel)
# Configure a mesma senha nos dois (Frontend manda, Backend valida).
VITE_API_SECRET="sua-senha-super-secreta"
SYNAP_API_SECRET="sua-senha-super-secreta"
